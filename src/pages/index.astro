---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page-shell">
    <header class="brand" aria-label="Trellis Works">
      <img class="brand-mark" src="/brand/trellisworks-mark.svg" alt="" />
      <img class="wordmark" src="/brand/trellisworks-wordmark.svg" alt="Trellis Works" />
    </header>

    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Better work, built deliberately</p>
      <h1 id="page-title">Practical systems for better work.</h1>
      <div class="brass-rule" aria-hidden="true"></div>
      <p class="copy">
        Trellis Works helps organizations improve how work gets done. We combine consulting,
        thoughtful workflow design, and useful technology to build solutions that fit the real
        needs of your business.
      </p>
      <p class="copy">
        We’re building a library of reusable tools and methods through client work, without
        forcing organizations into a one-size-fits-all product.
      </p>
      <p class="contact">
        <a href="mailto:info@trellisworks.ca">Start a conversation <span aria-hidden="true">→</span></a>
        <span>info@trellisworks.ca</span>
      </p>
    </section>
  </main>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    min-height: 100vh;
    margin: 0;
    background: #f6f4ee;
    color: #1b2430;
    font-family: "Segoe UI", ui-sans-serif, system-ui, sans-serif;
  }
  .page-shell {
    width: min(100% - 3rem, 72rem);
    min-height: 100vh;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5.5rem) 0 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
  }
  .brand-mark {
    width: 2.15rem;
    height: 2.1rem;
  }
  .wordmark {
    width: min(13.5rem, 58vw);
    height: auto;
  }
  .intro {
    max-width: 47rem;
    margin-top: clamp(5rem, 14vh, 10rem);
  }
  .eyebrow {
    margin: 0 0 1.35rem;
    color: #a9762f;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    max-width: 12ch;
    font-family: "Avenir Next LT Pro", "Avenir Next", Avenir, "Segoe UI", sans-serif;
    font-size: clamp(3.1rem, 8vw, 6.35rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .brass-rule {
    width: 5.5rem;
    height: 0.2rem;
    margin: 2.2rem 0 2.25rem;
    background: #a9762f;
  }
  .copy {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.18rem);
    line-height: 1.7;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.15rem;
    margin: 2.5rem 0 0;
    color: #5c6b78;
    font-size: 0.98rem;
  }
  a {
    color: #1b2430;
    font-weight: 700;
    text-decoration-color: #a9762f;
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.27em;
  }
  @media (max-width: 38rem) {
    .page-shell { width: min(100% - 2.25rem, 72rem); }
    .intro { margin-top: 4.5rem; }
  }
</style>

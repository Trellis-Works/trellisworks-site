      <button class="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" id="mobileToggle">☰</button>

      <div class="nav-wrap" id="navWrap">
        <nav class="nav" aria-label="Primary navigation">
          <a class="nav-link" href="#services">Services</a>
          <a class="nav-link" href="#approach">Approach</a>
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#contact">Contact</a>
        </nav>
        <a class="button button-primary nav-cta" href={contactHref} target="_blank" rel="noopener noreferrer">Let&apos;s Talk</a>

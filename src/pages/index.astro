---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <p class="eyebrow">Trellis Works</p>
    <h1>Practical systems for better work.</h1>
    <p class="copy">
      Trellis Works helps organizations improve how work gets done. We combine consulting,
      thoughtful workflow design, and useful technology to build solutions that fit the real
      needs of your business.
    </p>
    <p class="copy">
      We’re building a library of reusable tools and methods through client work—without
      forcing organizations into a one-size-fits-all product.
    </p>
    <p class="contact">
      <a href="mailto:info@trellisworks.ca">Get in touch: info@trellisworks.ca</a>
    </p>
  </main>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 2rem;
    background: #f6f4ee;
    color: #19332b;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  main { max-width: 42rem; }
  .eyebrow {
    margin: 0 0 1.5rem;
    color: #567268;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }
  .copy {
    max-width: 39rem;
    margin: 1.5rem 0 0;
    color: #40584f;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .contact { margin: 2.25rem 0 0; font-weight: 700; }
  a { color: #19332b; text-underline-offset: 0.2em; }
</style>

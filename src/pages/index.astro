---
import Layout from "../layouts/Layout.astro";

const contactHref = "https://mail.google.com/mail/?view=cm&fs=1&to=info%40trellisworks.ca&su=Let%27s%20talk%20about%20working%20together&body=Hi%20Trellis%20Works%2C%0D%0A%0D%0AI%27d%20like%20to%20explore%20how%20you%20could%20help%20our%20team.%0D%0A%0D%0AA%20little%20about%20our%20organization%3A%20%0D%0A%0D%0AWhat%20we%27d%20like%20to%20improve%3A%20%0D%0A%0D%0AThanks%2C%0D%0A%5BYour%20name%5D";
---

<Layout
  title="Trellis Works | Practical systems that unlock potential"
  description="Trellis Works helps organizations improve how work gets done by identifying where time, effort and resources are being lost, then designing practical systems that create capacity."
>
<header class="site-header">
    <div class="container header-inner">
      <a href="#home" class="brand" aria-label="Trellis Works home">

---
const links = [
  ["Home", "/"], ["Services", "/#services"], ["Solutions", "/#solutions"],
  ["Approach", "/#approach"], ["About", "/#about"],
  ["Contact", "/#contact"], ["For advisers", "/partners/"],
];
const contactHref = `https://mail.google.com/mail/?${new URLSearchParams({
  view: "cm", fs: "1", to: "info@trellisworks.ca", su: "Let's talk about working together",
  body: "Hi Trellis Works,\n\nI'd like to explore how you could help our team.\n\nA little about our organization:\n•\n\nWhat we'd like to improve:\n•\n\nThanks,\n[Your name]",
})}`;

4,2.09-.13.62-.58,1.45-2.13,2.38l-27.82-27.35.08,88.33,48.28-43.02-3.1-3.55c-.55-2.03,2.29-2.83,4.26-2.4V67.18s-63.11.03-63.11.03c-.53-1.65-.51-2.8.03-4.27h130.53ZM505.58,15.68h-83.08s42.16,42.68,42.16,42.68l40.92-42.68ZM259.6,60.83l-41.78-42.49-.04,85.26,41.83-42.77ZM509.12,103.58l.03-85.25-41.93,42.78,41.9,42.47ZM305.64,107.92l-43.36-44.31-42.99,44.41,86.35-.09ZM507,107.82l-42.26-43.71-43.25,43.96,85.51-.26ZM305.61,112.04l-87.09-.15,43.77,44.61,43.32-44.46ZM507.48,111.99l-87.05-.09,43.89,44.94,43.16-44.84ZM307.77,202.38l-.12-86.36-42.76,43.29,42.88,43.07ZM461.68,159.52l-42.81-43.34-.02,87.53,42.83-44.19ZM259.64,159.11l-41.76-41.94-.15,85.37,41.9-43.42ZM509.16,202.44l-.02-85.55-42.11,42.94,42.13,42.6ZM305.52,205.93l-43.22-43.7-42.69,43.89,85.92-.19ZM506.72,206.1l-42.19-43.41-42.33,43.35,84.52.05ZM305.3,210.06l-85.92-.12,43.16,43.57,42.76-43.45ZM507.32,209.88l-86.11.02,43.04,43.88,43.08-43.9ZM307.81,299.04l.06-85.68-42.71,42.86,42.65,42.82ZM461.58,256.72l-42.71-43.3-.06,86.42,42.76-43.12ZM509.16,299.27l-.03-85.85-42.08,43.25,42.11,42.61ZM259.98,256.32l-42.17-42.16.02,84.59,42.14-42.43ZM506.4,302.13l-42.07-42.61-41.81,42.56,83.88.05ZM305.22,301.88l-39.99-40.09c-1.56-1.73-3.99-1.81-5.31.15l-39.61,40.15,84.91-.21ZM409.63,301.98l-46.3-41.86-46.69,41.83,93,.03Z" fill="#2E3742"/>
        </svg></a>
    <button class="tw-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-navigation">Menu</button>
    <div class="tw-nav-wrap" id="site-navigation">
      <nav class="tw-nav" aria-label="Primary navigation">
        {links.map(([label, href]) => <a href={href} aria-current={href === Astro.url.pathname ? "page" : undefined}>{label}</a>)}
      </nav>
      <a class="tw-contact" href={contactHref} target="_blank" rel="noopener noreferrer">Let's talk</a>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.tw-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.tw-toggle');
  const navigation = header?.querySelector<HTMLElement>('.tw-nav-wrap');
  const updateHeight = () => {
    if (header) document.documentElement.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`);
  };
  updateHeight();
  if (header && 'ResizeObserver' in window) new ResizeObserver(updateHeight).observe(header);
  const setOpen = (open: boolean) => {
    navigation?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
  header?.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false); toggle.focus();
    }
  });

  // On the homepage, the active link follows the content below the sticky header.
  // Keep page-based highlighting (for example For advisers) on separate pages.
  if (window.location.pathname === '/') {
    const navLinks = Array.from(header?.querySelectorAll<HTMLAnchorElement>('.tw-nav a') ?? []);
    const sections = navLinks.flatMap(link => {
      const url = new URL(link.href);
      if (url.pathname !== '/') return [];
      const section = document.getElementById(url.hash.slice(1) || 'home');
      return section ? [{ link, section }] : [];
    });
    const homeLink = sections.find(({ section }) => section.id === 'home')?.link;
    let framePending = false;
    const updateActiveSection = () => {
      framePending = false;
      const readingLine = (header?.getBoundingClientRect().height ?? 111) + 32;
      let activeLink = homeLink;
      // Each nav section stays active until the next nav section begins.
      // This avoids returning to Services after its nested Solutions content.
      for (const { link, section } of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= readingLine) activeLink = link;
      }
      const atPageEnd = window.scrollY > 0 &&
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atPageEnd) activeLink = sections.find(({ section }) => section.id === 'contact')?.link ?? activeLink;
      for (const link of navLinks) {
        if (link === activeLink) link.setAttribute('aria-current', link === homeLink ? 'page' : 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const scheduleUpdate = () => {
      if (!framePending) {
        framePending = true;
        window.requestAnimationFrame(updateActiveSection);
      }
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate);
    scheduleUpdate();
  }
</script>
<style>
  .tw-header { position:sticky; top:0; z-index:50; background:rgba(246,244,238,.96); backdrop-filter:blur(18px); border-bottom:1px solid rgba(27,36,48,.08); color:#1b2430; }
  .tw-header-inner { width:min(calc(100% - 48px),1240px); margin:auto; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .tw-brand { display:flex; flex-shrink:0; padding:12px 8px; }
  .tw-logo { display:block; width:136px; height:auto; }
  .tw-nav-wrap,.tw-nav { display:flex; align-items:center; gap:14px; }
  .tw-nav { gap:2px; }
  .tw-nav a,.tw-contact { font-family:"Avenir Next",Avenir,"Segoe UI",sans-serif; text-transform:uppercase; font-size:14px; font-weight:500; letter-spacing:.08em; text-decoration:none; white-space:nowrap; }
  .tw-nav a { padding:12px 9px; color:#5c6b78; }
  .tw-nav a:hover,.tw-nav a[aria-current] { color:#1b2430; text-decoration:underline; text-underline-offset:6px; }
  .tw-contact { padding:15px 20px; color:#f6f4ee; background:#1b2430; border:1px solid #1b2430; }
  .tw-contact:hover { background:#334252; }
  .tw-toggle { display:none; border:1px solid rgba(27,36,48,.2); background:transparent; color:#1b2430; padding:12px 16px; font:inherit; cursor:pointer; }
  a:focus-visible,button:focus-visible { outline:3px solid #a9762f; outline-offset:5px; }
  :global(html) { scroll-padding-top:calc(var(--header-height,111px) + 16px); }
  @media(max-width:1120px) {
    .tw-toggle { display:block; }
    .tw-nav-wrap { display:none; position:absolute; top:100%; left:24px; right:24px; padding:20px; background:#f6f4ee; border:1px solid rgba(27,36,48,.14); box-shadow:0 20px 50px rgba(27,36,48,.1); flex-direction:column; align-items:stretch; }
    .tw-nav-wrap.is-open { display:flex; }
    .tw-nav { flex-direction:column; align-items:stretch; }
    .tw-nav a { display:block; padding:12px 0; }
    .tw-contact { text-align:center; }
  }
  @media(max-width:560px) {
    .tw-header-inner { width:calc(100% - 32px); }
    .tw-logo { width:122px; }
    .tw-nav-wrap { left:16px; right:16px; }
  }
</style>

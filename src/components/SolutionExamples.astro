---
const examples = [
  ["Recurring Excel reports", "Turn recurring exports and spreadsheet preparation into a repeatable reporting workflow, with checks and team handoff.", "/excel-reporting/"],
  ["Internal knowledge", "Help staff find and check answers in your company’s procedures and reference material, with links to the source.", "/internal-knowledge/"],
  ["Email workflows", "Organize incoming requests and prepare useful replies for your team to review before sending.", "/email-workflows/"],
  ["Team onboarding", "Turn existing training and walkthroughs into practical guides, checklists and support for one role.", "/onboarding/"],
];
---
<div class="solution-examples" id="solutions" aria-labelledby="solutions-heading">
  <h2 id="solutions-heading">Practical solutions for recurring work.</h2>
  <p class="examples-intro">A few ways we put our services to work. Start with one workflow; the scope is shaped around your team.</p>
  <div class="examples-grid">
    {examples.map(([title, description, href]) => <a class="example" href={href}><h3>{title}</h3><p>{description}</p><span>Explore this solution</span></a>)}
  </div>
</div>
<style>
  .solution-examples { margin-top:48px; padding-top:36px; border-top:1px solid rgba(27,36,48,.14); scroll-margin-top:calc(var(--header-height,111px) + 24px); }
  .solution-examples h2 { font-size:clamp(1.7rem,3vw,2.3rem); line-height:1.2; margin:0 0 18px; }
  .examples-intro { max-width:760px; color:#5c6b78; font-size:1rem; line-height:1.8; margin:0 0 28px; }
  .examples-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
  .example { display:block; border:1px solid rgba(27,36,48,.14); padding:28px; text-decoration:none; }
  .example:hover { border-color:#a9762f; }
  .example:focus-visible { outline:3px solid #a9762f; outline-offset:5px; }
  .example h3 { font-size:1.4rem; line-height:1.3; margin:0 0 14px; }
  .example p { color:#5c6b78; font-size:1rem; line-height:1.8; margin:0; }
  .example span { display:block; margin-top:18px; font-size:1rem; text-decoration:underline; text-underline-offset:5px; }
  @media(max-width:650px) { .examples-grid { grid-template-columns:1fr; } .example { padding:24px; } }
</style>
